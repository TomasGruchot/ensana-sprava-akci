generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hotel {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  color     String             @default("#6366f1")
  imageUrl  String?
  rooms     Room[]
  grants    PermissionGrant[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Room {
  id        String             @id @default(cuid())
  name      String
  hotelId   String
  color     String?
  hotel     Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  events    Event[]
  managers  RoomManager[]
  grants    PermissionGrant[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([hotelId, name])
}

model Event {
  id            String   @id @default(cuid())
  title         String
  description   String?
  date          DateTime
  dateEnd       DateTime?
  allDay        Boolean  @default(false)
  timeStart     String?
  timeEnd       String?
  contactPerson String?
  contactInfo   String?
  attendees     Int?
  attachmentName     String?
  attachmentPath     String?
  attachmentUrl      String?
  attachmentMimeType String?
  attachmentSize     Int?
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Profile {
  id        String             @id
  email     String             @unique
  name      String?
  avatarUrl String?
  role      Role               @default(USER)
  managers  RoomManager[]
  grants    PermissionGrant[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

enum Role {
  ADMIN
  IT
  USER
  MANAGER
  VIEWER
}

/// Granulární oprávnění pro hotel nebo konkrétní místnost (roomId null = celý hotel).
model PermissionGrant {
  id              String   @id @default(cuid())
  profileId       String
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  canCreateEvents Boolean  @default(false)
  canUpdateEvents Boolean  @default(false)
  canDeleteEvents Boolean  @default(false)
  canCreateHotels Boolean  @default(false)
  canUpdateHotels Boolean  @default(false)
  canDeleteHotels Boolean  @default(false)
  canManageUsers  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([profileId, hotelId, roomId])
}

model RoomManager {
  id        String   @id @default(cuid())
  roomId    String
  profileId String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([roomId, profileId])
}

/// Záznamy o všech akcích provedených přihlášenými uživateli.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String?
  actorName   String?
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([createdAt(sort: Desc)])
}
