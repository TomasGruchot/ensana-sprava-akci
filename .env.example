# =============================================================
# ENSANA — vyplň tenhle soubor, ulož jako .env, hotovo.
# =============================================================

# Heslo které sis zvolil při instalaci PostgreSQL
# (pro uživatele "postgres" — superadmin databáze)
POSTGRES_ADMIN_PASSWORD=<<<HESLO_Z_INSTALACE_POSTGRESQL>>>

# Heslo pro samotnou Ensana databázi — vymysli si cokoliv
POSTGRES_PASSWORD=<<<VYMYSLI_HESLO_PRO_DB>>>

# Spojení s databází — jen změň POSTGRES_PASSWORD výše, tohle nech jak je
DATABASE_URL=postgresql://ensana:<<<VYMYSLI_HESLO_PRO_DB>>>@localhost:5432/ensana

# První IT admin (přihlášení do webové aplikace)
ADMIN_EMAIL=<<<it@ensana.cz>>>
ADMIN_PASSWORD=<<<VYMYSLI_HESLO_PRO_PRIHLASENI>>>

# Kam ukládat přílohy a obrázky (složka se vytvoří sama)
UPLOADS_DIR=C:\apps\ensana-data\uploads

# IP adresa tohoto notebooku v hotelové síti
NEXT_PUBLIC_APP_URL=http://<<<192.168.1.89>>>
