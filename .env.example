# =============================================================
# ENSANA — KONFIGURACE APLIKACE
# Zkopíruj jako .env v kořeni projektu a vyplň hodnoty <<<
# Hodnoty ANON_KEY a SERVICE_ROLE_KEY musí být stejné
# jako v docker/supabase/.env
# =============================================================

# -------------------------------------------------------------
# DATABÁZE — připojení přímo na PostgreSQL
# Heslo musí souhlasit s POSTGRES_PASSWORD v docker/supabase/.env
# -------------------------------------------------------------

DATABASE_URL=postgresql://postgres:<<<POSTGRES_PASSWORD>>>@localhost:5432/postgres
DIRECT_URL=postgresql://postgres:<<<POSTGRES_PASSWORD>>>@localhost:5432/postgres

# -------------------------------------------------------------
# SUPABASE — po spuštění docker compose
# SERVER_IP = IP adresa tohoto serveru (např. 192.168.1.100)
# -------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=http://<<<SERVER_IP>>>:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=<<<ANON_KEY z docker/supabase/.env>>>
SUPABASE_SERVICE_ROLE_KEY=<<<SERVICE_ROLE_KEY z docker/supabase/.env>>>

# -------------------------------------------------------------
# URL APLIKACE — potřebné pro emaily (pozvánky, reset hesla)
# Musí být přístupná z internetu/sítě včetně prohlížeče uživatele
# -------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://<<<SERVER_IP>>>
