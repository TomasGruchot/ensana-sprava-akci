# =============================================================
# ENSANA — KONFIGURACE APLIKACE
# Zkopíruj jako .env v kořeni projektu a vyplň hodnoty <<<
# =============================================================

# -------------------------------------------------------------
# DATABÁZE — připojení na lokální PostgreSQL (Docker)
# Uživatel/heslo/název musí souhlasit s docker/postgres/.env
# -------------------------------------------------------------

DATABASE_URL=postgresql://ensana:<<<POSTGRES_PASSWORD>>>@localhost:5432/ensana

# -------------------------------------------------------------
# PRVNÍ IT ADMIN — vytvoří se při seedu (npm run db:seed)
# Tímto účtem se poprvé přihlásíš a vytvoříš ostatní uživatele.
# -------------------------------------------------------------

ADMIN_EMAIL=<<<admin@ensana.cz>>>
ADMIN_PASSWORD=<<<SILNE_HESLO_ADMINA>>>

# -------------------------------------------------------------
# ÚLOŽIŠTĚ SOUBORŮ — kam se ukládají přílohy, avatary, obrázky
# Doporučeno absolutní cesta mimo repozitář. Výchozí: ./uploads
# -------------------------------------------------------------

UPLOADS_DIR=C:\\apps\\ensana-data\\uploads

# -------------------------------------------------------------
# URL APLIKACE — IP serveru v síti (např. http://192.168.1.89)
# -------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://<<<SERVER_IP>>>
