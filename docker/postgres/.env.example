# =============================================================
# POSTGRESQL (Docker) — KONFIGURACE
# Zkopíruj jako .env ve složce docker/postgres/ a vyplň heslo.
# Heslo musí souhlasit s DATABASE_URL v kořenovém .env.
# =============================================================

POSTGRES_DB=ensana
POSTGRES_USER=ensana
POSTGRES_PASSWORD=<<<SILNE_HESLO_DB>>>
