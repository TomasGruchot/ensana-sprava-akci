# =============================================================
# SUPABASE SELF-HOSTED — KONFIGURACE
# Zkopíruj tento soubor jako .env ve složce docker/supabase/
# a vyplň všechny hodnoty označené <<<
# =============================================================

# -------------------------------------------------------------
# DATABÁZE
# -------------------------------------------------------------

# Silné heslo pro PostgreSQL (min. 16 znaků, žádné speciální znaky @ # %)
POSTGRES_PASSWORD=<<<SILNE_HESLO_DB>>>

POSTGRES_DB=postgres
POSTGRES_PORT=5432

# -------------------------------------------------------------
# JWT — podepisování tokenů
# Vygeneruj náhodný řetězec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -------------------------------------------------------------

JWT_SECRET=<<<NAHODNY_64_ZNAKOVY_RETEZEC>>>
JWT_EXPIRY=3600

# -------------------------------------------------------------
# API KLÍČE
# Vygeneruj pomocí: node scripts/generate-keys.mjs <JWT_SECRET>
# Výstup zkopíruj sem a také do .env aplikace
# -------------------------------------------------------------

ANON_KEY=<<<VYGENERUJ_PRES_scripts/generate-keys.mjs>>>
SERVICE_ROLE_KEY=<<<VYGENERUJ_PRES_scripts/generate-keys.mjs>>>

# -------------------------------------------------------------
# URL ADRESY
# SERVER_IP = IP adresa tohoto serveru v síti (např. 192.168.1.100)
# -------------------------------------------------------------

# URL kde poběží Supabase API (port 8000)
API_EXTERNAL_URL=http://<<<SERVER_IP>>>:8000

# URL kde poběží aplikace (port 80)
SITE_URL=http://<<<SERVER_IP>>>

# Další povolené redirect URL (volitelné, nech prázdné)
ADDITIONAL_REDIRECT_URLS=

# -------------------------------------------------------------
# EMAIL / SMTP
# Potřebné pro odesílání pozvánek a resetů hesla
# Nastav firemní SMTP nebo Gmail
# -------------------------------------------------------------

SMTP_ADMIN_EMAIL=<<<ADMIN@ENSANA.CZ>>>
SMTP_HOST=<<<SMTP.ENSANA.CZ>>>
SMTP_PORT=587
SMTP_USER=<<<SMTP_UZIVATEL>>>
SMTP_PASS=<<<SMTP_HESLO>>>
SMTP_SENDER_NAME=Ensana

# -------------------------------------------------------------
# OSTATNÍ
# -------------------------------------------------------------

# Zakázat registraci nových uživatelů přes /auth/v1/signup
# Pro interní systém nastav na true — uživatele lze přidávat jen přes admin
DISABLE_SIGNUP=true

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
